{
  "name": "busara",
  "version": "8.0.0-alpha.1",
  "private": true,
  "description": "Busara AI - Multi-Agent Data Intelligence Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@busara/web",
    "dev:agents": "turbo run dev --filter=@busara/agents",
    "dev:core": "turbo run dev --filter=@busara/core",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@busara/web",
    "build:agents": "turbo run build --filter=@busara/agents",
    "build:core": "turbo run build --filter=@busara/core",
    "start": "turbo run start",
    "start:web": "turbo run start --filter=@busara/web",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=@busara/web",
    "lint:agents": "turbo run lint --filter=@busara/agents",
    "lint:core": "turbo run lint --filter=@busara/core",
    "test": "turbo run test",
    "test:web": "turbo run test --filter=@busara/web",
    "test:agents": "turbo run test --filter=@busara/agents",
    "test:core": "turbo run test --filter=@busara/core",
    "test:watch": "turbo run test --watch",
    "test:coverage": "turbo run test --coverage",
    "typecheck": "turbo run typecheck",
    "typecheck:web": "turbo run typecheck --filter=@busara/web",
    "typecheck:agents": "turbo run typecheck --filter=@busara/agents",
    "typecheck:core": "turbo run typecheck --filter=@busara/core",
    "clean": "turbo run clean && rm -rf node_modules",
    "clean:all": "rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "db:generate": "turbo run db:generate --filter=@busara/web",
    "db:push": "turbo run db:push --filter=@busara/web",
    "db:migrate": "turbo run db:migrate --filter=@busara/web",
    "db:studio": "turbo run db:studio --filter=@busara/web",
    "docker:build": "docker-compose -f infrastructure/docker/docker-compose.yml build",
    "docker:up": "docker-compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose -f infrastructure/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@prisma/client": "6.19.3",
    "prisma": "6.19.3",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@types/react",
        "@types/react-dom"
      ]
    }
  },
  "keywords": [
    "ai",
    "data-analysis",
    "multi-agent",
    "machine-learning",
    "orchestration",
    "dag",
    "workflow",
    "busara"
  ],
  "author": "Victor Ndunda <victor@busara.ai>",
  "license": "MIT",
  "homepage": "https://busara.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/gadda00/IntelliFlow"
  },
  "bugs": {
    "url": "https://github.com/gadda00/IntelliFlow/issues"
  }
}
