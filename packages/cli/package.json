{
  "name": "@busara/cli",
  "version": "8.0.0-alpha.1",
  "private": true,
  "description": "Busara CLI — run agents, manage templates, inspect trajectories, and approve evolution from the terminal",
  "bin": {
    "busara": "dist/index.js"
  },
  "main": "dist/index.js",
