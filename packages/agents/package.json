{
  "name": "@busara/agents",
  "version": "8.0.0-alpha.1",
  "private": true,
  "description": "Busara Agents - Multi-agent orchestration framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
